      "link": null,
      "locked": false,
      "text": "\nFunctional Requirements\n1. Users can upload videos\n2. Users can stream selected videos\n3. Users can search for videos using keywords\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nFunctional Requirements\n1. Users can upload videos\n2. Users can stream selected videos\n3. Users can search for videos using keywords\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
