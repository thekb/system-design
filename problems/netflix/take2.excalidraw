      "isDeleted": false,
      "boundElements": null,
      "updated": 1764905940446,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements\n1. System should be available (streaming)\n2. System should be scalable \n3. System should support low latency streaming",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirements\n1. System should be available (streaming)\n2. System should be scalable \n3. System should support low latency streaming",
      "autoResize": true,
      "lineHeight": 1.25
