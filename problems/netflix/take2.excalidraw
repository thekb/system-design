      "isDeleted": false,
      "boundElements": null,
      "updated": 1764907203912,
      "link": null,
      "locked": false,
      "text": "Entities\nUser\nVideoMetadata\nVideoData\n\nAPIs\nPOST /video\n-> VideoMetadata\n<- {\nupload_url: <signed_url for blob store>\nid: <video_id>\n}\n\nRUD on video using {video_id}\n\nPOST /video/{id}/upload\n\nPOST /video/{id}/watch\n-> {\ntype: start|resume\nindex: <>\n}\n<- {\n    manifest: https://{cdn-endpoint}/videos/xxxxx/manifest.json\n    token: xxxxx\n}\n\n\nGET /search?keywords=<>\n<- {\nresults: []VideoMetadata\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\nUser\nVideoMetadata\nVideoData\n\nAPIs\nPOST /video\n-> VideoMetadata\n<- {\nupload_url: <signed_url for blob store>\nid: <video_id>\n}\n\nRUD on video using {video_id}\n\nPOST /video/{id}/upload\n\nPOST /video/{id}/watch\n-> {\ntype: start|resume\nindex: <>\n}\n<- {\n    manifest: https://{cdn-endpoint}/videos/xxxxx/manifest.json\n    token: xxxxx\n}\n\n\nGET /search?keywords=<>\n<- {\nresults: []VideoMetadata\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
