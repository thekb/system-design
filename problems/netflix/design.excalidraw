      "isDeleted": false,
      "boundElements": [],
      "updated": 1764360350015,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n1. Users can search for videos\n2. Users can stream selected videos\n3. Users should be able to upload their own videos\n\n----\n\nNon Functional Requirements\n1. System should be highly available\n2. System should support uploading large videos\n3. System should support low latency for stream videos\n    even in bandwidth constrained environments\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n1. Users can search for videos\n2. Users can stream selected videos\n3. Users should be able to upload their own videos\n\n----\n\nNon Functional Requirements\n1. System should be highly available\n2. System should support uploading large videos\n3. System should support low latency for stream videos\n    even in bandwidth constrained environments\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
