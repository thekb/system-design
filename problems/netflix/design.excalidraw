      "link": null,
      "locked": false,
      "text": "Entities\n\nUser\nVideo\nVideoMetadata\n\nAPIs\n\nPOST /upload\n-> {\nVideo\nVideoMetadata\n}\n\nGET /video/{id}\n<- {\nVideo\nVideoMetadata\n}\n\nGET /video/search?keywords=<>\n->{\nresults: []VideoMetadata\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\nUser\nVideo\nVideoMetadata\n\nAPIs\n\nPOST /upload\n-> {\nVideo\nVideoMetadata\n}\n\nGET /video/{id}\n<- {\nVideo\nVideoMetadata\n}\n\nGET /video/search?keywords=<>\n->{\nresults: []VideoMetadata\n}",
      "autoResize": true,
      "lineHeight": 1.25
