    {
      "id": "iO-uV5RLUAbwdLqLMUISM",
      "type": "text",
      "x": 459,
      "y": 225,
      "width": 587.8396606445312,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 146894675,
      "version": 382,
      "versionNonce": 121974387,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1750533199826,
      "link": null,
      "locked": false,
      "text": "1. Users should be able to run one off or scheduled jobs\n2. Users should be able to see the status of jobs\n\nNon Functional Requirements\n\n1. CAP - The system should be 99.99% uptime\n2. Latency - Jobs should be scheduled within 2 seconds\n3. Scalability - System should be able to handle > 100 Million\njobs per day\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Users should be able to run one off or scheduled jobs\n2. Users should be able to see the status of jobs\n\nNon Functional Requirements\n\n1. CAP - The system should be 99.99% uptime\n2. Latency - Jobs should be scheduled within 2 seconds\n3. Scalability - System should be able to handle > 100 Million\njobs per day\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
