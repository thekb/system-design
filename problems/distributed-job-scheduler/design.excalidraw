      "link": null,
      "locked": false,
      "text": "Entities\n\nUser\n\nJob\n- user_id\n- image\n- command\n- schedule (cron expression)\n\n\nJobRun (Job instance)\n- id\n- job_id\n- next_run\n- executed_at\n- status: pending | success | failure | inprogress ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\nUser\n\nJob\n- user_id\n- image\n- command\n- schedule (cron expression)\n\n\nJobRun (Job instance)\n- id\n- job_id\n- next_run\n- executed_at\n- status: pending | success | failure | inprogress ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "K36Y2BGJW2YEuln4F30na",
      "type": "text",
      "x": 465.125,
      "y": 1154.73046875,
      "width": 293.9997863769531,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
