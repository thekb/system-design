      "isDeleted": false,
      "boundElements": null,
      "updated": 1750533082715,
      "link": null,
      "locked": false,
      "text": "APIs\n\nPOST /jobs\n-> Job\n<- Job\n\nGET /jobs/{id}\n<- []Job\n\nGET /jobs/{id}/runs?page=<>\n<- []JobRun\n\nGET /jobs/{id}/runs/{id}\n<- JobRun",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs\n\nPOST /jobs\n-> Job\n<- Job\n\nGET /jobs/{id}\n<- []Job\n\nGET /jobs/{id}/runs?page=<>\n<- []JobRun\n\nGET /jobs/{id}/runs/{id}\n<- JobRun",
      "autoResize": true,
      "lineHeight": 1.25
    },
