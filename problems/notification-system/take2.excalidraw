    {
      "id": "t6sqVgiWPkyqe4iXc6lH1",
      "type": "text",
      "x": 300,
      "y": 600,
      "width": 474.7997131347656,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 908236861,
      "version": 316,
      "versionNonce": 2145421363,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753153160480,
      "link": null,
      "locked": false,
      "text": "Functional Reqs\n1. we need to track the status of a notification\n2. text notifications\n3. scheduled notifications ?\n\nNon Functional Reqs\n1. A >> C \n2. fault tolerant\n3. try to delivery exactly once\n4. scale 400 qps 80:20 bulk: single\nbulk can contain upto 40M recipients\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Reqs\n1. we need to track the status of a notification\n2. text notifications\n3. scheduled notifications ?\n\nNon Functional Reqs\n1. A >> C \n2. fault tolerant\n3. try to delivery exactly once\n4. scale 400 qps 80:20 bulk: single\nbulk can contain upto 40M recipients\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
