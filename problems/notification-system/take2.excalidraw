      "updated": 1753153224622,
      "link": null,
      "locked": false,
      "text": "Entities\n\nEventNotication\n- id \n- text\n- recipient\n- type: sms | push | email | tweet\n- status: pending | processed | deliverd\n\nBulkNotification\n- id\n- text\n- recipients ?\n- type: sms | push | email | tweet\n- status: pending | processed | delivered ?\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\nEventNotication\n- id \n- text\n- recipient\n- type: sms | push | email | tweet\n- status: pending | processed | deliverd\n\nBulkNotification\n- id\n- text\n- recipients ?\n- type: sms | push | email | tweet\n- status: pending | processed | delivered ?\n\n",
      "autoResize": true,
      "lineHeight": 1.25
