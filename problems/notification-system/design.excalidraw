      "versionNonce": 75986810,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752719555328,
      "link": null,
      "locked": false,
      "text": "DB design\n1. No relations in the data, we can use a noSQL database\nlike DynamoDB\n2. notification_id as PK as we will only supporting \n  id based lookup",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DB design\n1. No relations in the data, we can use a noSQL database\nlike DynamoDB\n2. notification_id as PK as we will only supporting \n  id based lookup",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VTSLl0l29C4wweQxvMLcw",
