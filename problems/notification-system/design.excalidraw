      "isDeleted": false,
      "boundElements": null,
      "updated": 1752720016110,
      "link": null,
      "locked": false,
      "text": "Queue\n1. Kafka like message queue\n2. notification topic sharded on \n  (notification_id, destination_type)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Queue\n1. Kafka like message queue\n2. notification topic sharded on \n  (notification_id, destination_type)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CrWFNpE_9tB1tEPGndbEg",
      "type": "rectangle",
      "x": 1453.5880126953125,
      "y": 967.8125,
      "width": 517.5703124999999,
      "height": 389.6484375,
