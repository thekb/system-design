    {
      "id": "oNepVTSCYqp05tv-evJ-K",
      "type": "text",
      "x": 401.999755859375,
      "y": 836.6484375,
      "width": 466.53961181640625,
      "height": 925,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
