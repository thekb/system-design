      "seed": 1676672186,
      "version": 675,
      "versionNonce": 496737254,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752720404663,
      "link": null,
      "locked": false,
      "text": "Entities\n\nNotification\n- id\n- text\n- destination_type: Email | SMS | Push | Tweet\n- recipient\n- status: pending | processed | delivered | failed\n- bulk_notification_id\n- chunk_id\n\nBulkNotification\n- id\n- text\n- destination_type: Email | SMS | Push | Tweet\n- recipients: s3://some-bucket/xxxx.json\n- status: pending | processed | delivered | failed\n\n\n\nAPI\n\nPOST /notifications/\n-> Notification\n<- Notification\n\nGET /noficiations/{id}\n<- Notification\n\nPOST /bulknotifications/\n-> BulkNotification\n<- BulkNotification\n\nGET /bulknotifications/{id}\n<- BulkNotification\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\nNotification\n- id\n- text\n- destination_type: Email | SMS | Push | Tweet\n- recipient\n- status: pending | processed | delivered | failed\n- bulk_notification_id\n- chunk_id\n\nBulkNotification\n- id\n- text\n- destination_type: Email | SMS | Push | Tweet\n- recipients: s3://some-bucket/xxxx.json\n- status: pending | processed | delivered | failed\n\n\n\nAPI\n\nPOST /notifications/\n-> Notification\n<- Notification\n\nGET /noficiations/{id}\n<- Notification\n\nPOST /bulknotifications/\n-> BulkNotification\n<- BulkNotification\n\nGET /bulknotifications/{id}\n<- BulkNotification\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
