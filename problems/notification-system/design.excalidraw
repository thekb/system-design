    },
    {
      "id": "1gKGcz0v1fw5EQ9LnQLVd",
      "type": "text",
      "x": 1477.0880126953125,
      "y": 1001,
      "width": 479.8596496582031,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": null,
      "seed": 1221646374,
      "version": 473,
      "versionNonce": 951194342,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752719946854,
      "link": null,
      "locked": false,
      "text": "Worker\n1. worker is reponsible for processing the \nnotification and sending it to the destination\nhandler\n2. after the notification is passed to the\ndestination handler, it updates the status\n\n3.  handles retries\n4. passes the notification_id as the idempotency\ntoken to the delivery handler, so that if the\ndelivery handler support idempotent operations,\nwe can avoid delivering duplicate notification\nduring retries",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Worker\n1. worker is reponsible for processing the \nnotification and sending it to the destination\nhandler\n2. after the notification is passed to the\ndestination handler, it updates the status\n\n3.  handles retries\n4. passes the notification_id as the idempotency\ntoken to the delivery handler, so that if the\ndelivery handler support idempotent operations,\nwe can avoid delivering duplicate notification\nduring retries",
      "autoResize": true,
      "lineHeight": 1.25
    },
