      "boundElements": null,
      "updated": 1753232809408,
      "link": null,
      "locked": false,
      "text": "BoE\n\nEvent triggered\n80 QPS\n\nBulk\n320 * 40 * 10 ^ 6\n~ 100 * 100 * 10 ^ 6\n~ 10 ^ 10\n~ 10 billion per second",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
