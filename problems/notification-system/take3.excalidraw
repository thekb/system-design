      "link": null,
      "locked": false,
      "text": "APIs\n\nPOST /notification\n-> EventNotification\n<- EventNotification\n\nGET /notification/{id}\n<- EventNotification\n\nPOST /bulknotification\n-> BulkNotification\n<- BulkNotification\n\nGET /bulknotification/{id}\n<- BulkNotification",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs\n\nPOST /notification\n-> EventNotification\n<- EventNotification\n\nGET /notification/{id}\n<- EventNotification\n\nPOST /bulknotification\n-> BulkNotification\n<- BulkNotification\n\nGET /bulknotification/{id}\n<- BulkNotification",
      "autoResize": true,
      "lineHeight": 1.25
    },
