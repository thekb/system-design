    {
      "id": "DMjIxZ2Ocqi71W1mu1IIx",
      "type": "text",
      "x": 2233.9888794880353,
      "y": 610.3294315004023,
      "width": 624.5195922851562,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1U",
      "roundness": null,
      "seed": 2043387641,
      "version": 1281,
      "versionNonce": 497142167,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753242734412,
      "link": null,
      "locked": false,
      "text": "Metrics\n1. request rate add type=single|bulk label\n2. for each topic single|bulk current and commited offset to\n    scale the number of consumers in group automatically\n3. number of notifications processed add type=single|bulk label, \n    channel sms|email|push|tweet\n4. for each channel topic track current and commited offset to \n    scale the number of consumers in group automatically\n5. number of notifications retried add type, channel, recipient\n6. number of failed notifications add type, channel, recipient\n7. number of notifications retried add type, channel, recipient\n8. db replication lag per shard\n9. cache hit rate for recipient cache\n10. rate of requests/notifications short circuited due to \n    idempotent handling\n11. db metrics per shard\n12. per channel handler latency\n13. per channel succesful/failed requests",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Metrics\n1. request rate add type=single|bulk label\n2. for each topic single|bulk current and commited offset to\n    scale the number of consumers in group automatically\n3. number of notifications processed add type=single|bulk label, \n    channel sms|email|push|tweet\n4. for each channel topic track current and commited offset to \n    scale the number of consumers in group automatically\n5. number of notifications retried add type, channel, recipient\n6. number of failed notifications add type, channel, recipient\n7. number of notifications retried add type, channel, recipient\n8. db replication lag per shard\n9. cache hit rate for recipient cache\n10. rate of requests/notifications short circuited due to \n    idempotent handling\n11. db metrics per shard\n12. per channel handler latency\n13. per channel succesful/failed requests",
      "autoResize": true,
      "lineHeight": 1.25
    },
