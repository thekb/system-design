      "isDeleted": false,
      "boundElements": null,
      "updated": 1753233181658,
      "link": null,
      "locked": false,
      "text": "Entities\n\nEventNotification\n- id\n- recipient_id\n- data\n- created_at\n- updated_at\n- status: pending | processed | delivered | failed\n\nNotificationOptions\n- enabled: bool\n- destination: string\n\nRecipientNotification\n- recipient_id\n- sms: NotificationOptions\n- email: NotificationOptions\n- push: NotificationOptions\n- tweet: NotificationOptions\n\nBulkNotification\n- id\n- status: pending | processed | delivered | failed\n- data\n- created_at\n- updated_at\n- recipients: pointer to location containing the recipients\n   reason: transferring 40M records might not be feasable \n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\nEventNotification\n- id\n- recipient_id\n- data\n- created_at\n- updated_at\n- status: pending | processed | delivered | failed\n\nNotificationOptions\n- enabled: bool\n- destination: string\n\nRecipientNotification\n- recipient_id\n- sms: NotificationOptions\n- email: NotificationOptions\n- push: NotificationOptions\n- tweet: NotificationOptions\n\nBulkNotification\n- id\n- status: pending | processed | delivered | failed\n- data\n- created_at\n- updated_at\n- recipients: pointer to location containing the recipients\n   reason: transferring 40M records might not be feasable \n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
