    {
      "id": "-jnQ9X5jg3-Fiw5JuWxlW",
      "type": "text",
      "x": -171.18999505321483,
      "y": 441.9890922866267,
      "width": 630.2996215820312,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1765426425,
      "version": 962,
      "versionNonce": 1729030521,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753233106010,
      "link": null,
      "locked": false,
      "text": "Clarifying questions\n1. does a single user have multiple ways of getting notified ? \n    yes\n2. what is the expected message delivery semantics ? \n    at least once\n    at most once\n    exactly once - lets try to deliver exactly once\n3. what is latency expectation ?\n    as soon as possible for event triggered\n    within 15 min for bulk notifications\n4. does it mean we need to prioritize event triggered over bulk ?\n    yes\n5. do we need to track the status of a notification ?\n    yes\n6. what kind of scale do we expect this system to handle ?\n    400 QPS 80:20 bulk:event\n    bulk notifications can have upto 40 M recipients\n7. are the notifications text only or do they contain media ?\n    text only\n8. do we need to schedule notifications ?\n    no ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Clarifying questions\n1. does a single user have multiple ways of getting notified ? \n    yes\n2. what is the expected message delivery semantics ? \n    at least once\n    at most once\n    exactly once - lets try to deliver exactly once\n3. what is latency expectation ?\n    as soon as possible for event triggered\n    within 15 min for bulk notifications\n4. does it mean we need to prioritize event triggered over bulk ?\n    yes\n5. do we need to track the status of a notification ?\n    yes\n6. what kind of scale do we expect this system to handle ?\n    400 QPS 80:20 bulk:event\n    bulk notifications can have upto 40 M recipients\n7. are the notifications text only or do they contain media ?\n    text only\n8. do we need to schedule notifications ?\n    no ",
      "autoResize": true,
      "lineHeight": 1.25
    },
