    {
      "id": "hSgktWZmULKC9Gd-zxT5Y",
      "type": "text",
      "x": 652.9310986967852,
      "y": 90.35237353662671,
      "width": 585.1596069335938,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 290989527,
      "version": 539,
      "versionNonce": 1932638775,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753232497332,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n\n1. should be able to create single/bulk notification\n2. should be able to track status\n\n\nNon Functional Requirements\n1. should be available to send notifications\n2. should be resilient to failures \n3. should deliver notifications within SLA\n4. should maintain QoS for different types of notifications ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n\n1. should be able to create single/bulk notification\n2. should be able to track status\n\n\nNon Functional Requirements\n1. should be available to send notifications\n2. should be resilient to failures \n3. should deliver notifications within SLA\n4. should maintain QoS for different types of notifications ",
      "autoResize": true,
      "lineHeight": 1.25
    },
