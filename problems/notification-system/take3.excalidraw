    {
      "id": "WRCwSck95We5ASwYxcxEF",
      "type": "text",
      "x": -177.5449218749999,
      "y": 95.2265625,
      "width": 672.8794555664062,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
