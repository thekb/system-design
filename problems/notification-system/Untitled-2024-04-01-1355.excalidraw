    {
      "id": "vkqZu7jhA24LspbxClF0Y",
      "type": "text",
      "x": 559.6484375,
      "y": 230.6484375,
      "width": 684.2196044921875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 2037046455,
      "version": 645,
      "versionNonce": 87067385,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759529845404,
      "link": null,
      "locked": false,
      "text": "Assume you have comprimised 1 M machines on the internet\nyour job is to bot net make some money using these machines\n-----------\nbot net\nbot net is controlling machines\nmachines need to be addressable \nmachines need to do some work\nwe need to make a sub set of machines do the work at the same time\n\n----\nwork can be independent \nbot net cp has to coordinate the work\n----\noptimize for latency and resiliency \nbot net cp has to be available \n---\nout of scope\n- how nodes are comprimised \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assume you have comprimised 1 M machines on the internet\nyour job is to bot net make some money using these machines\n-----------\nbot net\nbot net is controlling machines\nmachines need to be addressable \nmachines need to do some work\nwe need to make a sub set of machines do the work at the same time\n\n----\nwork can be independent \nbot net cp has to coordinate the work\n----\noptimize for latency and resiliency \nbot net cp has to be available \n---\nout of scope\n- how nodes are comprimised \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
