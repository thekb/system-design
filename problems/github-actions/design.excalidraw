      "link": null,
      "locked": false,
      "text": "Entities\n\nRepository\n\nTrigger\n- id\n- event\n- payload: JSON\n- repo_id\n\nWorkflow\n- id\n- repo_id\n- []Task\n- on_events: []string\n\nTask\n- name\n- config\n- needs: []\n\nWorflowRun\n- run_id\n- trigger_id\n- workflow_id\n- status\n- []TaskRun\n\nTaskRun\n- run_id\n- task_id\n- status\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\nRepository\n\nTrigger\n- id\n- event\n- payload: JSON\n- repo_id\n\nWorkflow\n- id\n- repo_id\n- []Task\n- on_events: []string\n\nTask\n- name\n- config\n- needs: []\n\nWorflowRun\n- run_id\n- trigger_id\n- workflow_id\n- status\n- []TaskRun\n\nTaskRun\n- run_id\n- task_id\n- status\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5xQ4qZccSOowkQSeK7JXW",
      "type": "text",
