      "updated": 1750540635182,
      "link": null,
      "locked": false,
      "text": "APIs\n\nPOST /workflow\n-> Workflow\n<- Workflow\n\nPOST /trigger\n-> Trigger\n<- Trigger\n\nGET /workflow/{id}/runs?page=<>\n<- []WorkflowRuns\n\nGET /workflow/{id}/runs/{id}\n<- WorkflowRun\n\nGET /workflow/{id}/runs/{id}/task/{id}\n<- TaskRun\n\nGET /workflow/{id}/runs/{id}/task/{id}/logs?offset=<>\n<- {\n\"lines\": \"\"\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs\n\nPOST /workflow\n-> Workflow\n<- Workflow\n\nPOST /trigger\n-> Trigger\n<- Trigger\n\nGET /workflow/{id}/runs?page=<>\n<- []WorkflowRuns\n\nGET /workflow/{id}/runs/{id}\n<- WorkflowRun\n\nGET /workflow/{id}/runs/{id}/task/{id}\n<- TaskRun\n\nGET /workflow/{id}/runs/{id}/task/{id}/logs?offset=<>\n<- {\n\"lines\": \"\"\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
