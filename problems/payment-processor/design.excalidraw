    {
      "id": "dhzIMZ34ZLFbNDAQiSSkD",
      "type": "text",
      "x": 396.3515625,
      "y": 515,
      "width": 579.0195922851562,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 775780836,
      "version": 527,
      "versionNonce": 1825563876,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1750621822684,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements\n1. CAP - Consistency for a single payment/order. Order\nshould not be charged more than once\n2. System should be fault tolerant. Orders/Txns should be\nrolled back safely \n3. System should scale to Millions to txns per day",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirements\n1. CAP - Consistency for a single payment/order. Order\nshould not be charged more than once\n2. System should be fault tolerant. Orders/Txns should be\nrolled back safely \n3. System should scale to Millions to txns per day",
      "autoResize": true,
      "lineHeight": 1.25
    },
