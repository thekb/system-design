      "text": "Entities\n\nTransaction\n- id\n- merchant_id\n- account_info: > encrypted\n  - card_number\n  - etc\n- bill_amount: string or \n    fixed precision/decimal\n- tip_amount: string or \n   fixed precision/decimal\n- created_at: datetime\n- updated_at: datetime\n- status: pending | hold_approved |\n  hold_denied | charged | \n  hold_expired\n- hold_expiry_at: datetime\n\n\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\nTransaction\n- id\n- merchant_id\n- account_info: > encrypted\n  - card_number\n  - etc\n- bill_amount: string or \n    fixed precision/decimal\n- tip_amount: string or \n   fixed precision/decimal\n- created_at: datetime\n- updated_at: datetime\n- status: pending | hold_approved |\n  hold_denied | charged | \n  hold_expired\n- hold_expiry_at: datetime\n\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
