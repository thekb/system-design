    {
      "id": "qt4oVY1Z9_-SpPNP78Z6k",
      "type": "text",
      "x": 451,
      "y": 185,
      "width": 512.939697265625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1732650332,
      "version": 556,
      "versionNonce": 534455524,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1750621378894,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n1. Should support Hold requests. Hold request can be\napproved or denied.\n2. If hold is approved, customer can sign and tip \n3. If no charge request is receivecd held funds are\nreleased\n4. All the charge requests are gathers up into a \nlarge batch file grouped by downstream processor.\n5. Every evening at 10PM, the file is send and the \nfunds are wire transferred in a big batch.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n1. Should support Hold requests. Hold request can be\napproved or denied.\n2. If hold is approved, customer can sign and tip \n3. If no charge request is receivecd held funds are\nreleased\n4. All the charge requests are gathers up into a \nlarge batch file grouped by downstream processor.\n5. Every evening at 10PM, the file is send and the \nfunds are wire transferred in a big batch.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
