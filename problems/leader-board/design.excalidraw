      "link": null,
      "locked": false,
      "text": "1. the system should display global leader board\n2. the system should show a users relative position in their\n    group of friends\n3. the system should display leader board aggregated daily,\n    weekly, monthly, seasonal etc.,",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. the system should display global leader board\n2. the system should show a users relative position in their\n    group of friends\n3. the system should display leader board aggregated daily,\n    weekly, monthly, seasonal etc.,",
      "autoResize": true,
      "lineHeight": 1.25
    },
