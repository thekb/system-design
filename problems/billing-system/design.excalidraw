      "link": null,
      "locked": false,
      "text": "APIs\n\nmetering.init(\n  service_id=<str>,\n  region=<str>,\n)\n\nmetering.v1.emit_usage(\n    resource_id=<str>,\n    resource_type=<str>,\n    metric_type=<str>,\n    value=<int64>,\n    account_id=<str>,\n)\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs\n\nmetering.init(\n  service_id=<str>,\n  region=<str>,\n)\n\nmetering.v1.emit_usage(\n    resource_id=<str>,\n    resource_type=<str>,\n    metric_type=<str>,\n    value=<int64>,\n    account_id=<str>,\n)\n\n",
