      "seed": 290634602,
      "version": 716,
      "versionNonce": 339879606,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1762110488994,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n1. any service can emit usage telemetry at arbitray granularity\n2. generate per account bill at configurable cadence\n3. users should be able to view their usage/bill with minimal latency\n\nNon Functional Requirements\n1. scalable (should be able to many services, billions of events per day)\n2. low latency near real time usage visibility (within minutes)\n3. strong correctness/audiability",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n1. any service can emit usage telemetry at arbitray granularity\n2. generate per account bill at configurable cadence\n3. users should be able to view their usage/bill with minimal latency\n\nNon Functional Requirements\n1. scalable (should be able to many services, billions of events per day)\n2. low latency near real time usage visibility (within minutes)\n3. strong correctness/audiability",
      "autoResize": true,
      "lineHeight": 1.25
    },
