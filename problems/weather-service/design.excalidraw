    {
      "id": "Oi1PKXSF2EmnTVWQP9lyF",
      "type": "text",
      "x": 395,
      "y": 594.64453125,
      "width": 421.17974853515625,
      "height": 1075,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 4457656,
      "version": 710,
      "versionNonce": 1434056053,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764647184433,
      "link": null,
      "locked": false,
      "text": "Entities\n\nCity\n- name\n- id\n- lat/long\n\nWeatherData\n- city_id\n- temperature: float\n- timestamp\n\nAlert\n- city_id\n- conditions\n- channels\n\nAPIs\n\nCRUD for adding cities\n\nGET /weather/name?from_ts=?&until_ts=?\n-> {\ndata: []Weather\n}\n\nPOST /weather/name/alert\n{\n    condition:[]Condition{\n        identifer: temperature\n        operator: GTE\n        value: 60\n    }\n    notify: []channel{\n        type: webhook|email\n        endpoint: <>\n        email: <>\n    }\n\n}\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\nCity\n- name\n- id\n- lat/long\n\nWeatherData\n- city_id\n- temperature: float\n- timestamp\n\nAlert\n- city_id\n- conditions\n- channels\n\nAPIs\n\nCRUD for adding cities\n\nGET /weather/name?from_ts=?&until_ts=?\n-> {\ndata: []Weather\n}\n\nPOST /weather/name/alert\n{\n    condition:[]Condition{\n        identifer: temperature\n        operator: GTE\n        value: 60\n    }\n    notify: []channel{\n        type: webhook|email\n        endpoint: <>\n        email: <>\n    }\n\n}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
