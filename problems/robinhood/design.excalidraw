      "text": "Entities\n\nUser\nStock\nOrder\n\nAPIs\n\nPOST /v1/buy\n-> StockOrder\n\nGET /v1/watch?symbols=?\n<- SSE\n{\n    Items: []Stock\n} \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities\n\nUser\nStock\nOrder\n\nAPIs\n\nPOST /v1/buy\n-> StockOrder\n\nGET /v1/watch?symbols=?\n<- SSE\n{\n    Items: []Stock\n} \n",
      "autoResize": true,
      "lineHeight": 1.25
