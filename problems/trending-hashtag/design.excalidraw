    {
      "id": "VFK2Pzb0KUwAAcYScRSTE",
      "type": "text",
      "x": 2475.838773869405,
      "y": 593.4384194347115,
      "width": 514.5996704101562,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1334410701,
      "version": 847,
      "versionNonce": 310641347,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1767036970540,
      "link": null,
      "locked": false,
      "text": "performs periodic aggregate update\nevery minute for 5 min, 15 min and 60 min aggregates\n\n5 is ZUNIONSTORE of last 5 1 minute\n15 is ZUNIONSTORE of last 15 1 minute\n60 is ZUNIONSTORE of last 60 minute\n\ntrim rolledup aggregates to 1000 results\n\nstore the 5, 15, 60 aggregates\nin {category}:5:latest\nexpire in window + grace period\n\ncache the topK API response \nfor fast response\n\n\noptimization:\nkeep list of keys used per aggregate\nif num of keys > agg size\npopleft \nZUNIONSTORE agg 3 agg nextkey poppedkey 1 1 -1\nZREMRANGEBYRANK agg 0 1000 \n\ndo it in lua script for transactional semantics\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "performs periodic aggregate update\nevery minute for 5 min, 15 min and 60 min aggregates\n\n5 is ZUNIONSTORE of last 5 1 minute\n15 is ZUNIONSTORE of last 15 1 minute\n60 is ZUNIONSTORE of last 60 minute\n\ntrim rolledup aggregates to 1000 results\n\nstore the 5, 15, 60 aggregates\nin {category}:5:latest\nexpire in window + grace period\n\ncache the topK API response \nfor fast response\n\n\noptimization:\nkeep list of keys used per aggregate\nif num of keys > agg size\npopleft \nZUNIONSTORE agg 3 agg nextkey poppedkey 1 1 -1\nZREMRANGEBYRANK agg 0 1000 \n\ndo it in lua script for transactional semantics\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
