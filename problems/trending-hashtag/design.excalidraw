    {
      "id": "39XHlkA0SesNLqaS9lii_",
      "type": "text",
      "x": 1666.4992948218526,
      "y": 37.532470662866615,
      "width": 244.05979919433594,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
