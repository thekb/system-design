      "link": null,
      "locked": false,
      "text": "gather categories\nfor a tweet/hashtags\nand emit\nindividual events\n\n{\n    \n    category: region/interests/etc\n    hashtag\n    event_id\n}\n\nfor multi dimentional categories\nemit compound categories\nex: global/sports, regional/sports\n\nThis can be done oppurtunistically to prevent\ncardinatity explosion",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "gather categories\nfor a tweet/hashtags\nand emit\nindividual events\n\n{\n    \n    category: region/interests/etc\n    hashtag\n    event_id\n}\n\nfor multi dimentional categories\nemit compound categories\nex: global/sports, regional/sports\n\nThis can be done oppurtunistically to prevent\ncardinatity explosion",
      "autoResize": true,
      "lineHeight": 1.25
    },
