      "isDeleted": false,
      "boundElements": [],
      "updated": 1758481680094,
      "link": null,
      "locked": false,
      "text": "Blob Store\n- snapshots of full Prefix Trie\n    used for IP/CIDR lookup\n- full bloom filter for negative \n   lookups before looking up in trie\n- allow list as hash set for\n    for look ups\n- every update creates immutable\n    snapshots\n- delta files are created for every \n    update\n- snapshots and deltas are signed\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Blob Store\n- snapshots of full Prefix Trie\n    used for IP/CIDR lookup\n- full bloom filter for negative \n   lookups before looking up in trie\n- allow list as hash set for\n    for look ups\n- every update creates immutable\n    snapshots\n- delta files are created for every \n    update\n- snapshots and deltas are signed\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
