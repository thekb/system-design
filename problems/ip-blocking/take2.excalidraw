    {
      "id": "ulVY7i53lnja7EvP64fiZ",
      "type": "text",
      "x": 386.5382050286088,
      "y": 261.8781185131151,
      "width": 563.9996337890625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 800817317,
      "version": 276,
      "versionNonce": 58771563,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1767668922730,
      "link": null,
      "locked": false,
      "text": "1. System should be able to fetch IP Blocklists from \n    government sources (APIs)\n2. System should support blocking IPV4/6 IP Addressess\n3. System should support region specific block lists",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. System should be able to fetch IP Blocklists from \n    government sources (APIs)\n2. System should support blocking IPV4/6 IP Addressess\n3. System should support region specific block lists",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AcnX71L23s_DZxSH6W3y6",
      "type": "text",
      "x": 388.90177112987107,
      "y": 558.505664221529,
      "width": 581.7796020507812,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1604918091,
      "version": 363,
      "versionNonce": 1774216587,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1767670120847,
      "link": null,
      "locked": false,
      "text": "1. System should be highly available and eventual consistent\n    (< 30s propagation of updates)\n2. System should support support low latency enforcement\n    ~1 micro second",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. System should be highly available and eventual consistent\n    (< 30s propagation of updates)\n2. System should support support low latency enforcement\n    ~1 micro second",
      "autoResize": true,
      "lineHeight": 1.25
    },
