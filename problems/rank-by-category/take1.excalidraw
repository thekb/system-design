      "boundElements": [],
      "updated": 1783025314459,
      "link": null,
      "locked": false,
      "text": "ecommerce website has rankings\nitems has rankings and one or more categories\nevery time someone buys an item\necommerce would send a signal category, count\nranking is number of items sold in 30 days period\nrounded to the nearest hour\n\nevery time a ranking appears api call get the ranking\nrank by category\nitems can have one or more categories\n(item, count)\n10^9 items sold per month\n10^8 per day\n10 categories per item\n10k total categories\n10 x 10^6 unique items\nglobal rankings\n-------\nFunctional requirements\n1. for a given category return the top n category\n2. top n items in category\n3. for a given item position in the categories\n-----\nNon Functional requirements\n1. writes have to be consistent\n2. reads can be eventually consistent (1 hour)\n3. scalable\n4. fault tolerant\n----\nBOE\n1. 10^8 sales per day -> 1000/s -> 1000 writes per second\n2. 10 ^5 reads per second\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 893,
      "containerId": null,
      "originalText": "ecommerce website has rankings\nitems has rankings and one or more categories\nevery time someone buys an item\necommerce would send a signal category, count\nranking is number of items sold in 30 days period\nrounded to the nearest hour\n\nevery time a ranking appears api call get the ranking\nrank by category\nitems can have one or more categories\n(item, count)\n10^9 items sold per month\n10^8 per day\n10 categories per item\n10k total categories\n10 x 10^6 unique items\nglobal rankings\n-------\nFunctional requirements\n1. for a given category return the top n category\n2. top n items in category\n3. for a given item position in the categories\n-----\nNon Functional requirements\n1. writes have to be consistent\n2. reads can be eventually consistent (1 hour)\n3. scalable\n4. fault tolerant\n----\nBOE\n1. 10^8 sales per day -> 1000/s -> 1000 writes per second\n2. 10 ^5 reads per second\n\n\n\n",
      "lineHeight": 1.25,
      "index": "a1",
      "autoResize": true
